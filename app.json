{
  "expo": {
    "name": "Rally",
    "slug": "rally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rally",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F2EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rally.weekspine",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.rally.weekspine",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#C3F53C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rally uses your photos so you can put a face on your profile, or a photo on a goal you closed. Only the people who can already see that goal can see the photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "backgroundColor": "#F1F2EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 132,
            "backgroundColor": "#070A06"
          },
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "8ea00fe8-1b14-4c07-af19-896ec6950ae6"
      }
    },
    "owner": "jphilistin12"
  }
}
