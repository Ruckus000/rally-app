# Copy to .env and fill in the key. .env is gitignored; this file is not.
#
# Both are read by Expo at build time. The EXPO_PUBLIC_ prefix is what makes
# them reachable from app code — it also means they are baked into the bundle
# and are NOT secret. Only ever put the publishable key here, never the
# service-role key.
#
# Project Settings → API keys → publishable key (sb_publishable_...).

EXPO_PUBLIC_SUPABASE_URL=https://zproxpxkxduzgxmzpeqa.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# For the authoring scripts only — bots:draft, bots:review, db:bots, goals:rate.
# No EXPO_PUBLIC_ prefix, deliberately: that prefix is what would bake it into
# the app bundle, and this key bills to an account. Nothing in src/ reads it.
# Get one from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
